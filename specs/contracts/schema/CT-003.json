{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CT-003 engine API",
  "version": "2.1.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "protocol",
    "operation",
    "parameters"
  ],
  "properties": {
    "protocol": {
      "type": "string",
      "description": "protocol version the caller speaks, e.g. 1.0.0"
    },
    "operation": {
      "type": "string",
      "description": "an operation from the catalogue in CT-003; meanings never change once shipped",
      "enum": [
        "workspace.open",
        "workspace.save",
        "workspace.close",
        "case.create",
        "case.delete",
        "case.move",
        "case.tag",
        "dataset.load",
        "dataset.describe",
        "field.declareUnit",
        "field.statistics",
        "variable.declare",
        "variable.set",
        "variable.detach",
        "view.create",
        "view.update",
        "view.duplicate",
        "view.rename",
        "view.delete",
        "view.render",
        "graph.create",
        "graph.update",
        "graph.duplicate",
        "graph.rename",
        "graph.delete",
        "graph.data",
        "diff.create",
        "report.create",
        "report.update",
        "report.duplicate",
        "report.rename",
        "report.delete",
        "report.export",
        "system.capabilities",
        "system.protocols",
        "history.undo",
        "history.list",
        "dataset.probe",
        "dataset.parts",
        "field.derive",
        "field.setDisplayUnit",
        "frame.declare",
        "measurement.import",
        "case.proposeTags",
        "template.createFromItem",
        "template.apply",
        "template.promote",
        "template.export",
        "template.import",
        "library.list",
        "pipeline.create",
        "pipeline.update",
        "pipeline.dryRun",
        "pipeline.run",
        "pipeline.cancel",
        "script.run",
        "report.provenance",
        "system.audit",
        "system.supportBundle",
        "workspace.pack",
        "output.prune"
      ]
    },
    "parameters": {
      "type": "object",
      "additionalProperties": true
    },
    "targets": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "groupId": {
      "type": "string",
      "description": "commands sharing this apply and undo together"
    },
    "authorisation": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "allowDestructive": {
          "type": "boolean",
          "default": false
        },
        "allowOverwrite": {
          "type": "boolean",
          "default": false
        },
        "allowNetwork": {
          "type": "boolean",
          "default": false
        }
      }
    },
    "dryRun": {
      "type": "boolean",
      "default": false
    }
  },
  "$defs": {
    "response": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status"
      ],
      "properties": {
        "status": {
          "type": "string",
          "enum": [
            "applied",
            "answered",
            "refused",
            "failed"
          ]
        },
        "changed": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "effectSummary": {
          "type": "string"
        },
        "undoId": {
          "type": "string"
        },
        "result": {
          "type": "object",
          "additionalProperties": true
        },
        "warnings": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/reason"
          }
        },
        "reason": {
          "$ref": "#/$defs/reason"
        }
      }
    },
    "reason": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "message"
      ],
      "properties": {
        "id": {
          "type": "string",
          "description": "stable identifier from the message catalogue; never changes once shipped"
        },
        "message": {
          "type": "string",
          "description": "resolved text, translated; for people not for matching"
        },
        "operation": {
          "type": "string"
        },
        "detail": {
          "type": "object",
          "additionalProperties": true
        }
      }
    },
    "handle": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "bytes",
        "expiresAfterSeconds"
      ],
      "description": "large payloads are fetched separately rather than carried in a response",
      "properties": {
        "id": {
          "type": "string"
        },
        "bytes": {
          "type": "integer",
          "minimum": 0
        },
        "encoding": {
          "type": "string"
        },
        "expiresAfterSeconds": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "operationParameters": {
      "description": "引数の名前・型・必須／任意を、操作ごとに。表の散文の列は残し、文脈での意味を述べる仕事に専念する — 名前がどこで終わるかを散文から推測させないため（OPEN-028）",
      "properties": {
        "workspace.open": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "path"
          ],
          "properties": {
            "path": {
              "type": "string",
              "description": "開くワークスペースファイルのパス"
            }
          }
        },
        "workspace.save": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "workspaceId"
          ],
          "properties": {
            "workspaceId": {
              "type": "string",
              "description": "ワークスペース の識別子（CT-001）"
            },
            "path": {
              "type": "string",
              "description": "別名で保存する先"
            }
          }
        },
        "workspace.close": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "workspaceId"
          ],
          "properties": {
            "workspaceId": {
              "type": "string",
              "description": "ワークスペース の識別子（CT-001）"
            }
          }
        },
        "case.create": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "name",
            "workspaceId"
          ],
          "properties": {
            "workspaceId": {
              "type": "string",
              "description": "ワークスペース の識別子（CT-001）"
            },
            "name": {
              "type": "string",
              "description": "ケース名。同じ種類の中で一意"
            },
            "parentCaseId": {
              "type": "string",
              "description": "親ケース の識別子（CT-001）"
            }
          }
        },
        "case.delete": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "caseId"
          ],
          "properties": {
            "caseId": {
              "type": "string",
              "description": "ケース の識別子（CT-001）"
            }
          }
        },
        "case.move": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "caseId",
            "newParentId"
          ],
          "properties": {
            "caseId": {
              "type": "string",
              "description": "ケース の識別子（CT-001）"
            },
            "newParentId": {
              "type": "string",
              "description": "移動先の親ケース の識別子（CT-001）"
            }
          }
        },
        "case.tag": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "caseId",
            "tags"
          ],
          "properties": {
            "caseId": {
              "type": "string",
              "description": "ケース の識別子（CT-001）"
            },
            "tags": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "description": "付けるタグ"
            }
          }
        },
        "dataset.load": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "caseId",
            "filePaths"
          ],
          "properties": {
            "caseId": {
              "type": "string",
              "description": "ケース の識別子（CT-001）"
            },
            "filePaths": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "description": "読み込むファイル"
            }
          }
        },
        "dataset.describe": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "datasetId"
          ],
          "properties": {
            "datasetId": {
              "type": "string",
              "description": "データセット の識別子（CT-001）"
            }
          }
        },
        "field.declareUnit": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "datasetId",
            "fieldName",
            "unitSymbol"
          ],
          "properties": {
            "datasetId": {
              "type": "string",
              "description": "データセット の識別子（CT-001）"
            },
            "fieldName": {
              "type": "string",
              "description": "フィールド名"
            },
            "unitSymbol": {
              "type": "string",
              "description": "宣言する単位。積・商も可（XC-244）"
            }
          }
        },
        "field.statistics": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "datasetId",
            "fieldName"
          ],
          "properties": {
            "datasetId": {
              "type": "string",
              "description": "データセット の識別子（CT-001）"
            },
            "fieldName": {
              "type": "string",
              "description": "フィールド名"
            },
            "region": {
              "type": "string",
              "description": "対象範囲。省略時は全体で、その範囲は結果に記録される（INV-017）"
            }
          }
        },
        "variable.declare": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "name",
            "value"
          ],
          "properties": {
            "name": {
              "type": "string",
              "description": "変数名"
            },
            "value": {
              "description": "値。数値・文字列・真偽"
            },
            "workspaceId": {
              "type": "string",
              "description": "ワークスペース の識別子（CT-001）"
            },
            "caseId": {
              "type": "string",
              "description": "ケース の識別子（CT-001）"
            },
            "unit": {
              "type": "string",
              "description": "宣言する単位。無ければ未宣言として扱う（XC-003）"
            }
          },
          "oneOf": [
            {
              "required": [
                "workspaceId"
              ]
            },
            {
              "required": [
                "caseId"
              ]
            }
          ],
          "description": "変数はワークスペースかケースのどちらかに属します。どちらでもない宣言は行き場がありません"
        },
        "variable.set": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "value",
            "variableId"
          ],
          "properties": {
            "variableId": {
              "type": "string",
              "description": "変数 の識別子（CT-001）"
            },
            "value": {
              "description": "新しい値"
            }
          }
        },
        "variable.detach": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "caseId",
            "variableId"
          ],
          "properties": {
            "caseId": {
              "type": "string",
              "description": "ケース の識別子（CT-001）"
            },
            "variableId": {
              "type": "string",
              "description": "変数 の識別子（CT-001）"
            }
          }
        },
        "view.create": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "definition",
            "workspaceId"
          ],
          "properties": {
            "workspaceId": {
              "type": "string",
              "description": "ワークスペース の識別子（CT-001）"
            },
            "definition": {
              "type": "object",
              "description": "CT-004 のビュー定義"
            },
            "sourceTemplateId": {
              "type": "string",
              "description": "元テンプレート の識別子（CT-001）"
            },
            "sourceTemplateRevision": {
              "type": "integer",
              "minimum": 1,
              "description": "版。省略も既定もしない — 誰も選んでいない固定は実行日の最新版に追随する"
            }
          }
        },
        "view.update": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "definition",
            "viewId"
          ],
          "properties": {
            "viewId": {
              "type": "string",
              "description": "ビュー の識別子（CT-001）"
            },
            "definition": {
              "type": "object",
              "description": "CT-004"
            }
          }
        },
        "view.duplicate": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "newName",
            "viewId"
          ],
          "properties": {
            "viewId": {
              "type": "string",
              "description": "ビュー の識別子（CT-001）"
            },
            "newName": {
              "type": "string",
              "description": "複製の名前"
            }
          }
        },
        "view.rename": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "newName",
            "viewId"
          ],
          "properties": {
            "viewId": {
              "type": "string",
              "description": "ビュー の識別子（CT-001）"
            },
            "newName": {
              "type": "string",
              "description": "新しい名前"
            }
          }
        },
        "view.delete": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "viewId"
          ],
          "properties": {
            "viewId": {
              "type": "string",
              "description": "ビュー の識別子（CT-001）"
            }
          }
        },
        "view.render": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "format",
            "height",
            "viewId",
            "width"
          ],
          "properties": {
            "viewId": {
              "type": "string",
              "description": "ビュー の識別子（CT-001）"
            },
            "width": {
              "type": "integer",
              "minimum": 1
            },
            "height": {
              "type": "integer",
              "minimum": 1
            },
            "format": {
              "type": "string",
              "enum": [
                "png",
                "jpeg",
                "webp"
              ]
            }
          }
        },
        "graph.create": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "definition",
            "workspaceId"
          ],
          "properties": {
            "workspaceId": {
              "type": "string",
              "description": "ワークスペース の識別子（CT-001）"
            },
            "definition": {
              "type": "object",
              "description": "CT-005 のグラフ定義"
            },
            "sourceTemplateId": {
              "type": "string",
              "description": "元テンプレート の識別子（CT-001）"
            },
            "sourceTemplateRevision": {
              "type": "integer",
              "minimum": 1,
              "description": "版。省略も既定もしない — 誰も選んでいない固定は実行日の最新版に追随する"
            }
          }
        },
        "graph.update": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "definition",
            "graphId"
          ],
          "properties": {
            "graphId": {
              "type": "string",
              "description": "グラフ の識別子（CT-001）"
            },
            "definition": {
              "type": "object",
              "description": "CT-005"
            }
          }
        },
        "graph.duplicate": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "graphId",
            "newName"
          ],
          "properties": {
            "graphId": {
              "type": "string",
              "description": "グラフ の識別子（CT-001）"
            },
            "newName": {
              "type": "string",
              "description": "複製の名前"
            }
          }
        },
        "graph.rename": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "graphId",
            "newName"
          ],
          "properties": {
            "graphId": {
              "type": "string",
              "description": "グラフ の識別子（CT-001）"
            },
            "newName": {
              "type": "string",
              "description": "新しい名前"
            }
          }
        },
        "graph.delete": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "graphId"
          ],
          "properties": {
            "graphId": {
              "type": "string",
              "description": "グラフ の識別子（CT-001）"
            }
          }
        },
        "graph.data": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "graphId"
          ],
          "properties": {
            "graphId": {
              "type": "string",
              "description": "グラフ の識別子（CT-001）"
            }
          }
        },
        "diff.create": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "basisCaseId",
            "caseIdA",
            "caseIdB"
          ],
          "properties": {
            "caseIdA": {
              "type": "string",
              "description": "左のケース の識別子（CT-001）"
            },
            "caseIdB": {
              "type": "string",
              "description": "右のケース の識別子（CT-001）"
            },
            "basisCaseId": {
              "type": "string",
              "description": "どちらのメッシュ上で比べるか。利用者が指名する（XC-038）"
            }
          }
        },
        "report.create": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "definition",
            "workspaceId"
          ],
          "properties": {
            "workspaceId": {
              "type": "string",
              "description": "ワークスペース の識別子（CT-001）"
            },
            "definition": {
              "type": "object",
              "description": "CT-006 のレポート定義"
            },
            "sourceTemplateId": {
              "type": "string",
              "description": "元テンプレート の識別子（CT-001）"
            },
            "sourceTemplateRevision": {
              "type": "integer",
              "minimum": 1,
              "description": "版。省略も既定もしない — 誰も選んでいない固定は実行日の最新版に追随する"
            }
          }
        },
        "report.update": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "definition",
            "reportId"
          ],
          "properties": {
            "reportId": {
              "type": "string",
              "description": "レポート の識別子（CT-001）"
            },
            "definition": {
              "type": "object",
              "description": "CT-006"
            }
          }
        },
        "report.duplicate": {
