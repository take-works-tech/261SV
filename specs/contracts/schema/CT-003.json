              "type": "string",
              "description": "レポート の識別子（CT-001）"
            },
            "newName": {
              "type": "string",
              "description": "複製の名前"
            }
          }
        },
        "report.rename": {
          "type": "object",
          "additionalProperties": false,
          "required": [
