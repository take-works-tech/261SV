              "type": "string",
              "description": "レポート の識別子（CT-001）"
            },
            "newName": {
              "type": "string",
              "description": "新しい名前"
            }
          }
        },
        "report.delete": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "reportId"
          ],
          "properties": {
            "reportId": {
              "type": "string",
              "description": "レポート の識別子（CT-001）"
            }
          }
        },
        "report.export": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "path",
            "reportId"
          ],
          "properties": {
            "reportId": {
              "type": "string",
              "description": "レポート の識別子（CT-001）"
            },
            "path": {
              "type": "string",
              "description": "書き出し先"
            }
          }
        },
        "system.capabilities": {
          "type": "object",
          "additionalProperties": false,
          "required": [],
          "properties": {}
        },
        "system.protocols": {
          "type": "object",
          "additionalProperties": false,
          "required": [],
          "properties": {}
        },
        "history.undo": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "undoId"
          ],
          "properties": {
            "undoId": {
              "type": "string",
              "description": "取り消し の識別子（CT-001）"
            }
          }
        },
        "history.list": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "workspaceId"
          ],
          "properties": {
            "workspaceId": {
              "type": "string",
              "description": "ワークスペース の識別子（CT-001）"
            }
          }
        },
        "dataset.probe": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "datasetId",
            "pointM",
            "resultPosition"
          ],
          "properties": {
            "datasetId": {
              "type": "string",
              "description": "データセット の識別子（CT-001）"
            },
            "pointM": {
              "type": "array",
              "items": {
                "type": "number"
              },
              "minItems": 3,
              "maxItems": 3,
              "description": "正準フレームのメートル座標（INV-001）"
            },
            "resultPosition": {
              "type": "integer",
              "minimum": 0,
              "description": "結果軸上の位置。時間とは限らない（XC-131）"
            }
          }
        },
        "dataset.parts": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "datasetId"
          ],
          "properties": {
            "datasetId": {
              "type": "string",
              "description": "データセット の識別子（CT-001）"
            }
          }
        },
        "field.derive": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "datasetId",
            "fieldName",
            "quantity"
          ],
          "properties": {
            "datasetId": {
              "type": "string",
              "description": "データセット の識別子（CT-001）"
            },
            "fieldName": {
              "type": "string",
