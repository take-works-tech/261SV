{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CT-005 graph definition",
  "version": "2.0.0",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "id",
    "kind",
    "series"
  ],
  "properties": {
    "id": {
      "type": "string"
    },
    "name": {
      "type": "string"
    },
    "kind": {
      "type": "string",
      "enum": [
        "line",
        "scatter",
        "bar",
        "histogram",
        "overTime",
        "overLine",
        "surface3d",
        "scatter3d",
        "contour3d"
      ]
    },
    "series": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "label",
          "source"
        ],
        "properties": {
          "label": {
            "type": "string"
          },
          "source": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "kind"
            ],
            "properties": {
              "kind": {
                "type": "string",
                "enum": [
                  "field",
                  "derived",
                  "referenceFile"
                ]
              },
              "datasetId": {
                "type": "string"
              },
              "fieldName": {
                "type": "string"
              },
              "association": {
                "type": "string",
                "enum": [
                  "point",
                  "cell"
                ]
              },
              "expression": {
                "type": "string",
                "description": "recorded for provenance; evaluated by the engine, never by generated code"
              },
              "path": {
                "type": "string"
              }
            }
          },
          "unit": {
            "type": "string"
          },
          "unitDeclared": {
            "type": "boolean",
            "description": "false means the axis carries the undeclared marker"
          },
          "style": {
            "type": "object",
            "additionalProperties": true
          }
        }
      }
    },
    "axes": {
      "type": "object",
      "additionalProperties": true
    },
    "caseSelection": {
      "type": "object",
      "additionalProperties": false,
      "description": "which cases and which repeats contribute, for repeated studies",
      "properties": {
        "caseIds": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "acrossTimeSteps": {
          "type": "boolean"
        },
        "acrossCases": {
          "type": "boolean"
        }
      }
    },
    "projection": {
      "type": "object",
      "additionalProperties": false,
      "description": "required for the three-dimensional kinds: a surface read from one angle is a different claim from another (graph/AC-026)",
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "orthographic",
            "perspective"
          ]
        },
        "viewDirection": {
          "type": "array",
          "items": {
            "type": "number"
          },
          "minItems": 3,
          "maxItems": 3
        }
      }
    },
    "resultAxisNote": {
      "type": "string",
      "description": "present when series come from different result axes - a mode index and a time may not share an axis silently (XC-131)"
    },
    "summaryWeighting": {
      "type": "string",
      "enum": [
        "volumeWeighted",
        "areaWeighted",
        "unweighted"
      ],
      "default": "volumeWeighted",
      "description": "how a summary statistic was reduced; an unweighted reduction is labelled wherever it appears (INV-017)"
    }
  }
}
