{
  "env": {
    "SHELL": "C:\\Program Files\\Git\\usr\\bin\\bash.exe",
    "BASH_EXECUTABLE": "C:\\Program Files\\Git\\usr\\bin\\bash.exe"
  },
  "outputStyle": "sim-viewer",
  "permissions": {
    "defaultMode": "acceptEdits",
    "allow": [
      "Read(*)",
      "Grep(*)",
      "Glob(*)",
      "Edit(*)",
      "Write(*)",
      "Bash(python validate/*)",
      "Bash(python -m pytest*)",
      "Bash(python spike/*)",
      "Bash(python -V*)",
      "Bash(.venv/Scripts/python*)",
      "Bash(.venv-spike/Scripts/python*)",
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git show*)",
      "Bash(git branch*)",
      "Bash(git remote -v*)",
      "Bash(git add*)",
      "Bash(git commit*)",
      "Bash(gh repo view*)",
      "Bash(gh auth status*)",
      "Bash(gh run list*)",
      "Bash(gh run view*)",
      "Bash(gh pr view*)",
      "Bash(gh pr list*)",
      "Bash(npm run typecheck*)",
      "Bash(npm run lint*)",
      "Bash(npm run build*)"
    ],
    "ask": [
      "Bash(git push*)",
      "Bash(git remote add*)",
      "Bash(git remote set-url*)",
      "Bash(gh repo create*)",
      "Bash(gh pr create*)",
      "Bash(gh pr merge*)",
      "Bash(gh secret*)",
      "Bash(gh api*)"
    ],
    "deny": [
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Bash(git reset --hard*)",
      "Bash(git clean -fd*)",
      "Bash(git filter-branch*)",
      "Bash(git rebase*)",
      "Bash(gh repo delete*)",
      "Bash(gh release delete*)",
      "Bash(rm -rf*)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python \"$CLAUDE_PROJECT_DIR/.claude/hooks/spec_gate.py\""
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "python \"$CLAUDE_PROJECT_DIR/.claude/hooks/spec_gate.py\""
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Write|Edit|NotebookEdit|Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "python \"$CLAUDE_PROJECT_DIR/.claude/hooks/local_only_guard.py\""
          }
        ]
      }
    ]
  }
}
