#!/bin/sh
# Refuse a push that the gates would refuse, and a push that rewrites history.
#
# This exists because of a measured gap, not a preference. Branch protection is unavailable for a
# private repository on a free personal account (OPEN-020: both the rulesets API and the classic
# branch-protection API answer HTTP 403), so GitHub cannot require a check or refuse a force-push.
# The only other guard is `.claude/hooks/local_only_guard.py`, which runs inside an agent session and
# is **silent in a plain terminal** - which is where a `git push --force` typed from muscle memory
# actually happens.
#
# Client-side, and therefore skippable with `--no-verify`. That is the honest limit of it: this
# catches the push nobody meant to make, not the one somebody insists on. A server-side ruleset is
# still the real answer, and `.github/ruleset-main.json` holds it ready.
#
# Install once per clone (versioned, so it travels with the repository):
#     git config core.hooksPath .githooks

set -eu

remote_name="${1:-origin}"
root=$(git rev-parse --show-toplevel)
cd "$root"

fail() {
    printf '\npush refused: %s\n' "$1" >&2
    printf 'Run the gates, or `git push --no-verify` if you are certain.\n\n' >&2
    exit 1
}

# 1. History is append-only here. A deleted or non-fast-forward update destroys the record of a
#    correction, and this project treats that record as part of what it ships.
zero="0000000000000000000000000000000000000000"

# Carriage returns are stripped before parsing. git itself never sends them, but this repository is
# worked on from Windows and anything that writes to this hook's stdin through a text stream may add
# them - a trailing \r on a SHA turns `merge-base --is-ancestor` into a silent failure, which reads
# as "would not fast-forward" and refuses a perfectly ordinary push. Read once, strip, then loop in
# this shell rather than a pipeline's subshell, so `fail` can actually exit.
refspecs=$(tr -d '\r')

while read -r local_ref local_sha remote_ref remote_sha; do
    [ -z "${local_ref:-}" ] && continue
    if [ "$local_sha" = "$zero" ]; then
        fail "deleting $remote_ref on $remote_name; branches are not deleted by push here"
    fi
    if [ "$remote_sha" != "$zero" ]; then
        if ! git merge-base --is-ancestor "$remote_sha" "$local_sha" 2>/dev/null; then
            fail "$remote_ref would not fast-forward - this rewrites published history (XC-186)"
        fi
    fi
done <<REFSPECS
$refspecs
REFSPECS

# 2. The gates decide what may land. Running them here costs a few seconds and saves a red main that
#    nothing on the server would have stopped. The test suite is deliberately NOT run: it needs the
#    engine environment, and a hook that fails for a missing optional dependency is a hook everyone
#    learns to pass with --no-verify.
# Pick an interpreter that *runs*, not the first name that resolves. On Windows, `python3` is usually
# the Microsoft Store stub: it is on PATH, `command -v` finds it, and it exits non-zero printing
# "Python was not found". Taking it on faith made every gate look red for a reason that had nothing to
# do with the change - which is precisely how a hook teaches people to reach for --no-verify. Found by
# running this hook, not by reading it.
python=""
for candidate in python3 python py; do
    command -v "$candidate" >/dev/null 2>&1 || continue
    if [ "$candidate" = "py" ]; then
        if py -3 -c "" >/dev/null 2>&1; then python="py -3"; break; fi
        continue
    fi
    if "$candidate" -c "" >/dev/null 2>&1; then python="$candidate"; break; fi
done

if [ -z "$python" ]; then
    printf 'pre-push: NOT checked - no working Python interpreter on PATH, so the gates did not run.\n' >&2
    exit 0
fi

# Exit 3 means "this gate needs something this machine has not started" - the catalogue sweep needs a
# served build (XC-218). It is reported, never hidden: a gate that skips quietly here is read as a gate
# that passed.
failed=""
skipped=""
for gate in validate/check_*.py; do
    [ -f "$gate" ] || continue
    case "$gate" in *test_*) continue ;; esac
    $python "$gate" >/dev/null 2>&1 && continue
    if [ $? -eq 3 ]; then
        skipped="$skipped $gate"
    else
        failed="$failed $gate"
    fi
done

if [ -n "$skipped" ]; then
    printf 'pre-push: not run here (needs a running service), left to CI:%s
' "$skipped" >&2
fi

if [ -n "$failed" ]; then
    printf '\nGates failing:%s\n' "$failed" >&2
    for gate in $failed; do
        printf '\n--- %s ---\n' "$gate" >&2
        $python "$gate" 2>&1 | tail -20 >&2
    done
    fail "the repository gates are red"
fi

exit 0
