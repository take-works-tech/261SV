# Line endings are the reason this file exists. The repository is worked on from Windows, and its
# gates read files as text: a CRLF that reaches a fixture or a licence text turns a byte-identical
# comparison into a diff nobody meant to make.

root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.py]
indent_size = 4
max_line_length = 100

[*.md]
# Two trailing spaces are a hard line break in Markdown, and the specification set uses wrapped prose
# where trimming them would silently rewrap a paragraph.
trim_trailing_whitespace = false

[Makefile]
indent_style = tab
