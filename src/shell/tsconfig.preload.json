{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "ES2022",
      "DOM"
    ],
    "module": "Node16",
    "moduleResolution": "Node16",
    "types": [
      "node"
    ],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "isolatedModules": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "outDir": "dist-preload",
    "rootDir": ".."
  },
  "include": [
    "preload.cts"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "dist-preload"
  ]
}
